{
  "name": "supabase-experiment",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",

  "features": {
    // moby:false is required - the base image is Debian trixie, which has no
    // 'moby-cli' package and the feature's default fails to install there.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },

  // Mount the workspace at the SAME absolute path it has on the host. Load-bearing:
  // the Supabase CLI runs in here but drives the HOST daemon, so the bind mounts it
  // requests (supabase/functions -> edge runtime) are resolved against host paths.
  // Change this and edge functions mount as an empty directory.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",

  // The CLI reaches the services on their published ports and defaults to
  // 127.0.0.1, which in here is this container. Point it at the host gateway.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": { "SUPABASE_SERVICES_HOSTNAME": "host.docker.internal" },

  "remoteUser": "node",
  "postCreateCommand": "npm ci",
  "postStartCommand": ".devcontainer/setup.sh",

  // No forwardPorts: the Supabase ports are published by the host daemon, so they
  // are already on the host's localhost. This container never binds them.

  "customizations": {
    "vscode": { "extensions": ["denoland.vscode-deno", "esbenp.prettier-vscode"] }
  }
}
