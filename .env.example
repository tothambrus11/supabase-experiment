# One Supabase instance, two URLs. Which one you need depends on WHERE the code
# runs, because the devcontainer and the Supabase containers are siblings on the
# host daemon - they do not share a "localhost".

# Code running INSIDE the devcontainer (SSR, seed/migration scripts, tests).
SUPABASE_URL=http://host.docker.internal:54321

# Code running in the HOST BROWSER (client components, anything the bundler
# inlines and ships to the browser). Note the different prefix - pick whichever
# your framework uses (VITE_, NEXT_PUBLIC_, PUBLIC_, ...).
VITE_SUPABASE_URL=http://localhost:54321

# Direct database connection from inside the devcontainer.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Local keys are fixed, well-known demo values - not secrets. Get the current
# ones with `npx supabase status`.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
