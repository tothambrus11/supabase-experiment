# Same Supabase instance, two URLs: the devcontainer and the Supabase containers
# are siblings, so they do not share a "localhost".
SUPABASE_URL=http://host.docker.internal:54321   # code running INSIDE the devcontainer
VITE_SUPABASE_URL=http://localhost:54321         # code running in the HOST browser

# Local keys are fixed demo values, not secrets. Get them with `npx supabase status`.
SUPABASE_ANON_KEY=
